# Copy to .env and adjust. Every value is optional; defaults are shown.

# --- LLM (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
CHAT_MODEL=qwen2.5:14b-instruct
# Smaller/faster model for background fact extraction + summaries (defaults to CHAT_MODEL)
EXTRACT_MODEL=
EMBED_MODEL=nomic-embed-text
# Must match EMBED_MODEL's vector size; changing it requires a fresh DB.
EMBED_DIM=768
LLM_TEMPERATURE=0.4
LLM_SEED=42
LLM_NUM_CTX=8192

# --- WhatsApp ---
# Digits with country code (e.g. 31612345678) to log in with a pairing code
# instead of scanning a QR code.
PAIRING_NUMBER=
# Gets escalation alerts and can send "!resume <number>" / "!pause <number>".
# Example: 31612345678@s.whatsapp.net
OWNER_JID=
# Comma-separated chat JIDs; when set, the bot ignores everyone else (handy for testing).
ALLOWED_JIDS=
# Answer in groups only when @mentioned or replied to.
REPLY_IN_GROUPS=false

# --- Human-like behaviour ---
HUMANIZE=true
# Typing speed in characters per second (5–7 ≈ 40–55 wpm)
TYPING_CPS_MIN=5
TYPING_CPS_MAX=7
# Random delay before the FIRST reply in a new chat, or after we haven't
# replied for COLD_START_AFTER_MIN minutes (log-uniform: mostly short, sometimes long)
FIRST_REPLY_MIN_MS=20000
FIRST_REPLY_MAX_MS=150000
COLD_START_AFTER_MIN=60
# Chance of stopping mid-message to "think" (per ~4-9s of typing)
TYPING_PAUSE_CHANCE=0.25
# Chance per reply of a 3-15s distraction before starting to type
DISTRACTION_CHANCE=0.1
# Wait this long after the last message of a burst before answering
DEBOUNCE_MS=3000
DEBOUNCE_MAX_MS=10000

# --- Memory / RAG ---
HISTORY_MESSAGES=20
SUMMARIZE_AFTER=40
RAG_TOP_K=6
# Cosine distance cut-off (0 = identical, 2 = opposite); lower = stricter
RAG_MAX_DISTANCE=0.6
IMAGE_RESEND_HOURS=24

# --- Paths ---
DB_PATH=data/astrid.db
AUTH_DIR=data/auth
CONFIG_DIR=config
KNOWLEDGE_DIR=knowledge
LOG_LEVEL=info
