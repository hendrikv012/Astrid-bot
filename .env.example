# Copy to .env and adjust. Every value is optional; defaults are shown.

# --- LLM (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
CHAT_MODEL=qwen2.5:14b-instruct
# Smaller/faster model for background fact extraction + summaries (defaults to CHAT_MODEL)
EXTRACT_MODEL=
EMBED_MODEL=nomic-embed-text
# Must match EMBED_MODEL's vector size; changing it requires a fresh DB.
EMBED_DIM=768
LLM_TEMPERATURE=0.4
LLM_SEED=42
LLM_NUM_CTX=8192

# --- WhatsApp ---
# Digits with country code (e.g. 31612345678) to log in with a pairing code
# instead of scanning a QR code.
PAIRING_NUMBER=
# Gets a WhatsApp alert ONLY when a customer wants to buy or agrees to buy, and
# can send "!resume <number>" / "!pause <number>".
# Your number with country code, no leading 0: 31612345678 (or 31612345678@s.whatsapp.net)
OWNER_JID=
# Leave empty to answer everyone. When set (comma-separated numbers), the bot
# answers only these and ignores everyone else (handy for testing).
ALLOWED_JIDS=
# Answer in groups only when @mentioned or replied to.
REPLY_IN_GROUPS=false

# --- Dashboard (http://127.0.0.1:3210) ---
DASHBOARD_ENABLED=true
# Keep 127.0.0.1 unless you know what you are doing: the dashboard shows customer chats.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3210
# Optional fixed token (min 16 chars). If empty, one is generated, stored in the DB
# and printed in the startup log as a ready-to-click link.
DASHBOARD_TOKEN=

# --- Throughput (100–200 messages/min needs tuning; run: npm run loadtest) ---
# Model calls at the same time. Start Ollama with OLLAMA_NUM_PARALLEL set to the same value.
LLM_CONCURRENCY=2
# Background memory work (facts, summaries) waits for replies, but never longer than this.
BACKGROUND_MAX_WAIT_SEC=120
# Outgoing messages per minute for the whole number. Lower = lower ban risk, but
# replies queue up when customers write faster than this. Never dropped.
OUTBOUND_MAX_PER_MIN=120
# From this share of the cap (0–1), multi-bubble replies are merged into one message.
OUTBOUND_MERGE_AT=0.5

# --- Human-like behaviour ---
# These are startup defaults; changes saved in the dashboard override them.
HUMANIZE=true
# Typing speed in characters per second (5–7 ≈ 40–55 wpm)
TYPING_CPS_MIN=5
TYPING_CPS_MAX=7
# Random delay before the FIRST reply in a new chat, or after we haven't
# replied for COLD_START_AFTER_MIN minutes (log-uniform: mostly short, sometimes long)
FIRST_REPLY_MIN_MS=20000
FIRST_REPLY_MAX_MS=150000
# (set FIRST_REPLY_MIN_MS=0 and FIRST_REPLY_MAX_MS=0 while testing for quick replies)
COLD_START_AFTER_MIN=60
# Chance of stopping mid-message to "think" (per ~4-9s of typing)
TYPING_PAUSE_CHANCE=0.25
# Chance per reply of a 3-15s distraction before starting to type
DISTRACTION_CHANCE=0.1
# Wait this long after the last message of a burst before answering
DEBOUNCE_MS=3000
DEBOUNCE_MAX_MS=10000

# --- Memory / RAG ---
HISTORY_MESSAGES=20
SUMMARIZE_AFTER=40
RAG_TOP_K=6
# Cosine distance cut-off (0 = identical, 2 = opposite); lower = stricter
RAG_MAX_DISTANCE=0.6
IMAGE_RESEND_HOURS=24

# --- Paths ---
DB_PATH=data/astrid.db
AUTH_DIR=data/auth
CONFIG_DIR=config
KNOWLEDGE_DIR=knowledge
LOG_LEVEL=info
