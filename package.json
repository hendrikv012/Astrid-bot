{
    "name": "astrid-bot",
    "version": "0.1.0",
    "private": true,
    "description": "Astrid: a WhatsApp bot on Baileys with SOP-driven behavior, per-chat SQLite memory, RAG and human-like typing",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "start:pm2": "npm run build && pm2 start ecosystem.config.cjs",
        "restart:pm2": "npm run build && pm2 restart astrid --update-env",
        "stop:pm2": "pm2 stop astrid",
        "logs": "pm2 logs astrid",
        "status": "pm2 status astrid",
        "pm2:save": "pm2 save",
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "ingest": "tsx src/rag/ingest.ts",
        "loadtest": "tsx src/tools/loadtest.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run lint && npm run format:check",
        "prepare": "is-ci || husky"
    },
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "dependencies": {
        "baileys": "7.0.0-rc14",
        "better-sqlite3": "^13.0.3",
        "dotenv": "^16.6.1",
        "ollama": "^0.6.4",
        "pino": "^10.4.0",
        "qrcode-terminal": "^0.12.0",
        "sqlite-vec": "^0.1.9",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.4.3",
        "@commitlint/config-conventional": "^20.4.3",
        "@eslint/js": "^9.39.4",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^22.0.0",
        "@types/qrcode-terminal": "^0.12.2",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "is-ci": "^4.1.0",
        "lint-staged": "^16.3.2",
        "prettier": "^3.8.1",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^5.0.3"
    }
}
